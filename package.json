{
  "name": "music-effect",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev-manager.mjs",
    "dev:manager": "node scripts/dev-manager.mjs",
    "dev:player": "vite --host 127.0.0.1",
    "dev:songs": "node scripts/serve-song-packs.mjs",
    "build": "tsc --noEmit && vite build",
    "test": "node --test",
    "docs:check": "node --test tests/docs-consistency.test.mjs",
    "download:songle": "powershell -ExecutionPolicy Bypass -File scripts/download-songle-json.ps1",
    "song:scaffold": "node scripts/create-song-pack.mjs",
    "song:lyrics:install": "node scripts/install-lyrics-data.mjs",
    "song:lyrics:gui": "node scripts/dev-lyrics-installer.mjs",
    "song:validate": "node scripts/validate-song-pack.mjs",
    "song:smoke": "node scripts/smoke-song-pack.mjs",
    "song:smoke:all": "node scripts/smoke-all-song-packs.mjs",
    "preview:snapshot": "node scripts/preview-snapshot.mjs",
    "sync:ready": "node scripts/worktree-sync.mjs ready",
    "sync:brief": "node scripts/worktree-sync.mjs brief",
    "sync:check": "node scripts/worktree-sync.mjs check",
    "sync:merge": "node scripts/worktree-sync.mjs merge",
    "sync:list": "node scripts/worktree-sync.mjs list",
    "sync:roster": "node scripts/worktree-sync.mjs roster",
    "sync:note": "node scripts/worktree-sync.mjs note",
    "sync:ack": "node scripts/worktree-sync.mjs ack",
    "sync:inbox": "node scripts/worktree-sync.mjs inbox",
    "sync:onboard": "node scripts/worktree-sync.mjs onboard",
    "sync:watch": "node scripts/worktree-sync.mjs watch"
  },
  "devDependencies": {
    "@types/three": "^0.184.1",
    "typescript": "^5.8.3",
    "vite": "^6.3.5"
  },
  "dependencies": {
    "three": "^0.184.0"
  }
}
