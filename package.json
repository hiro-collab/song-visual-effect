{
  "name": "music-effect",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev-manager.mjs",
    "dev:manager": "node scripts/dev-manager.mjs",
    "dev:player": "vite --host 127.0.0.1",
    "dev:songs": "node scripts/serve-song-packs.mjs",
    "build": "tsc --noEmit && vite build",
    "download:songle": "powershell -ExecutionPolicy Bypass -File scripts/download-songle-json.ps1",
    "sync:ready": "node scripts/worktree-sync.mjs ready",
    "sync:check": "node scripts/worktree-sync.mjs check",
    "sync:merge": "node scripts/worktree-sync.mjs merge",
    "sync:list": "node scripts/worktree-sync.mjs list",
    "sync:note": "node scripts/worktree-sync.mjs note",
    "sync:inbox": "node scripts/worktree-sync.mjs inbox",
    "sync:watch": "node scripts/worktree-sync.mjs watch"
  },
  "devDependencies": {
    "typescript": "^5.8.3",
    "vite": "^6.3.5"
  }
}
